[
  {
    "check_id": "CKV_AWS_19",
    "name": "S3 Server-Side Encryption",
    "description": "Enforce default AES-256 server-side encryption via additive attachment.",
    "resource_type": "aws_s3_bucket",
    "framework": "HIPAA",
    "statute_reference": "HIPAA \u00a7164.312(a)(2)(iv) & GDPR Art. 32(1)(a)",
    "control_ids": [
      "HIPAA_164_312_a_2_iv",
      "GDPR_Art_32_1_a",
      "PCI_DSS_3_4",
      "NIST_SC_13"
    ],
    "requirement_id": "REQ_ENCRYPTION_AT_REST",
    "strategy": "ADDITIVE_ATTACHMENT",
    "target_attribute": null,
    "attribute_value": null,
    "additive_resource_template": "\nresource \"aws_s3_bucket_server_side_encryption_configuration\" \"{name}_encryption\" {{\n  bucket = {resource_id}.id\n\n  rule {{\n    apply_server_side_encryption_by_default {{\n      sse_algorithm = \"AES256\"\n    }}\n  }}\n}}\n",
    "validation_rules": [
      "require_sse_algorithm_aes256",
      "prevent_destructive_bucket_recreation"
    ]
  },
